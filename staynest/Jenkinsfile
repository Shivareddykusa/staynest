pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '036179729550'

        FRONTEND_ECR = 'staynest-frontend'
        BACKEND_ECR = 'staynest-backend'

        IMAGE_TAG = "${BUILD_NUMBER}"

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Project') {
            steps {
                sh '''
                    echo "Checking project structure..."

                    test -f frontend/Dockerfile
                    test -f backend/Dockerfile
                    test -f frontend/nginx.conf
                    test -f backend/requirements.txt
                    test -f backend/app.py

                    echo "Project structure verified."
                '''
            }
        }

        stage('Build Frontend Docker Image') {
            steps {
                sh '''
                    echo "Building frontend image..."

                    docker build \
                        -t ${FRONTEND_ECR}:${IMAGE_TAG} \
                        -t ${FRONTEND_ECR}:latest \
                        ./frontend
                '''
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                sh '''
                    echo "Building backend image..."

                    docker build \
                        -t ${BACKEND_ECR}:${IMAGE_TAG} \
                        -t ${BACKEND_ECR}:latest \
                        ./backend
                '''
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                    echo "Logging into Amazon ECR..."

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Tag Frontend Image') {
            steps {
                sh '''
                    echo "Tagging frontend image..."

                    docker tag \
                        ${FRONTEND_ECR}:${IMAGE_TAG} \
                        ${ECR_REGISTRY}/${FRONTEND_ECR}:${IMAGE_TAG}

                    docker tag \
                        ${FRONTEND_ECR}:latest \
                        ${ECR_REGISTRY}/${FRONTEND_ECR}:latest
                '''
            }
        }

        stage('Tag Backend Image') {
            steps {
                sh '''
                    echo "Tagging backend image..."

                    docker tag \
                        ${BACKEND_ECR}:${IMAGE_TAG} \
                        ${ECR_REGISTRY}/${BACKEND_ECR}:${IMAGE_TAG}

                    docker tag \
                        ${BACKEND_ECR}:latest \
                        ${ECR_REGISTRY}/${BACKEND_ECR}:latest
                '''
            }
        }

        stage('Push Frontend to ECR') {
            steps {
                sh '''
                    echo "Pushing frontend image..."

                    docker push \
                        ${ECR_REGISTRY}/${FRONTEND_ECR}:${IMAGE_TAG}

                    docker push \
                        ${ECR_REGISTRY}/${FRONTEND_ECR}:latest
                '''
            }
        }

        stage('Push Backend to ECR') {
            steps {
                sh '''
                    echo "Pushing backend image..."

                    docker push \
                        ${ECR_REGISTRY}/${BACKEND_ECR}:${IMAGE_TAG}

                    docker push \
                        ${ECR_REGISTRY}/${BACKEND_ECR}:latest
                '''
            }
        }
    }

    post {
        success {
            echo "=========================================="
            echo "BUILD SUCCESSFUL"
            echo "=========================================="
            echo "Frontend: ${ECR_REGISTRY}/${FRONTEND_ECR}:${IMAGE_TAG}"
            echo "Backend : ${ECR_REGISTRY}/${BACKEND_ECR}:${IMAGE_TAG}"
        }

        failure {
            echo "=========================================="
            echo "BUILD FAILED"
            echo "=========================================="
        }

        always {
            sh '''
                docker logout ${ECR_REGISTRY} || true
            '''
        }
    }
}
