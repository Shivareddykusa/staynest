pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '036179729550'

        FRONTEND_ECR = 'staynest-frontend'
        BACKEND_ECR = 'staynest-backend'

        IMAGE_TAG = "${BUILD_NUMBER}"

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Project') {
            steps {
                sh '''
                    echo "=========================================="
                    echo "Checking project structure..."
                    echo "=========================================="

                    test -f staynest/frontend/Dockerfile
                    test -f staynest/backend/Dockerfile
                    test -f staynest/frontend/nginx.conf
                    test -f staynest/backend/requirements.txt
                    test -f staynest/backend/app.py

                    echo "Project structure verified successfully."
                '''
            }
        }

        stage('Build Frontend Docker Image') {
            steps {
                sh '''
                    echo "=========================================="
                    echo "Building Frontend Docker Image"
                    echo "=========================================="

                    docker build \
                        -t ${FRONTEND_ECR}:${IMAGE_TAG} \
                        -t ${FRONTEND_ECR}:latest \
                        ./staynest/frontend

                    echo "Frontend Docker image built successfully."
                '''
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                sh '''
                    echo "=========================================="
                    echo "Building Backend Docker Image"
                    echo "=========================================="

                    docker build \
                        -t ${BACKEND_ECR}:${IMAGE_TAG} \
                        -t ${BACKEND_ECR}:latest \
                        ./staynest/backend

                    echo "Backend Docker image built successfully."
                '''
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                    echo "=========================================="
                    echo "Logging into Amazon ECR"
                    echo "=========================================="

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}

                    echo "ECR login successful."
                '''
            }
        }

        stage('Tag Frontend Image') {
            steps {
                sh '''
                    echo "Tagging Frontend Docker Image..."

                    docker tag \
                        ${FRONTEND_ECR}:${IMAGE_TAG} \
                        ${ECR_REGISTRY}/${FRONTEND_ECR}:${IMAGE_TAG}

                    docker tag \
                        ${FRONTEND_ECR}:latest \
                        ${ECR_REGISTRY}/${FRONTEND_ECR}:latest

                    echo "Frontend image tagged successfully."
                '''
            }
        }

        stage('Tag Backend Image') {
            steps {
                sh '''
                    echo "Tagging Backend Docker Image..."

                    docker tag \
                        ${BACKEND_ECR}:${IMAGE_TAG} \
                        ${ECR_REGISTRY}/${BACKEND_ECR}:${IMAGE_TAG}

                    docker tag \
                        ${BACKEND_ECR}:latest \
                        ${ECR_REGISTRY}/${BACKEND_ECR}:latest

                    echo "Backend image tagged successfully."
                '''
            }
        }

        stage('Push Frontend to ECR') {
            steps {
                sh '''
                    echo "=========================================="
                    echo "Pushing Frontend Image to ECR"
                    echo "=========================================="

                    docker push \
                        ${ECR_REGISTRY}/${FRONTEND_ECR}:${IMAGE_TAG}

                    docker push \
                        ${ECR_REGISTRY}/${FRONTEND_ECR}:latest

                    echo "Frontend image pushed successfully."
                '''
            }
        }

        stage('Push Backend to ECR') {
            steps {
                sh '''
                    echo "=========================================="
                    echo "Pushing Backend Image to ECR"
                    echo "=========================================="

                    docker push \
                        ${ECR_REGISTRY}/${BACKEND_ECR}:${IMAGE_TAG}

                    docker push \
                        ${ECR_REGISTRY}/${BACKEND_ECR}:latest

                    echo "Backend image pushed successfully."
                '''
            }
        }
    }

    post {
        success {
            echo "=========================================="
            echo "       BUILD SUCCESSFUL"
            echo "=========================================="

            echo "Frontend ECR:"
            echo "${ECR_REGISTRY}/${FRONTEND_ECR}:${IMAGE_TAG}"

            echo "Backend ECR:"
            echo "${ECR_REGISTRY}/${BACKEND_ECR}:${IMAGE_TAG}"

            echo "=========================================="
        }

        failure {
            echo "=========================================="
            echo "          BUILD FAILED"
            echo "=========================================="
            echo "Check the Console Output for the error."
            echo "=========================================="
        }

        always {
            sh '''
                docker logout ${ECR_REGISTRY} || true
            '''
        }
    }
}
